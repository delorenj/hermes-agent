# Install as ~/.hermes/profiles/<profile>/outbound-audio-drain.env.op (mode 0600). op:// references only:
# `op run` resolves them for the drain process alone; the gateway never loads this file.
# The vault item does not exist yet: create a writer credential scoped to s3:PutObject/s3:GetObject/
# s3:HeadObject on earshot-replies/replies/* and point these at its fields.
HOLOC_OUTBOUND_AUDIO_S3_ACCESS_KEY_ID=op://DeLoSecrets/HOLOC Outbound Audio S3 Writer/access_key_id
HOLOC_OUTBOUND_AUDIO_S3_SECRET_ACCESS_KEY=op://DeLoSecrets/HOLOC Outbound Audio S3 Writer/secret_access_key
